{
  "env": {
    "browser": false,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "import/no-extraneous-dependencies": ["error", {"devDependencies": ["**/*.test.js", "**/*.spec.js", "jest.config.js", "test-*.js", "src/testing/**/*", "src/ui-tests/**/*", "**/*wdyr*"]}],
    "class-methods-use-this": "off",
    "no-restricted-syntax": "off",
    "no-plusplus": "off",
    "no-param-reassign": "off",
    "no-await-in-loop": "warn",
    "consistent-return": "off",
    "no-unused-vars": "warn",
    "no-useless-constructor": "off",
    "no-empty-function": "off",
    "no-promise-executor-return": "off",
    "no-useless-escape": "off",
    "no-continue": "off",
    "global-require": "off",
    "max-len": ["error", { "code": 200, "ignoreComments": true, "ignoreUrls": true }]
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "extends": [
        "airbnb-base",
        "plugin:@typescript-eslint/recommended"
      ],
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
          "jsx": true
        }
      },
      "settings": {
        "import/resolver": {
          "typescript": {
            "alwaysTryTypes": true,
            "project": "./tsconfig.json"
          },
          "node": {
            "extensions": [".js", ".jsx", ".ts", ".tsx"]
          }
        }
      },
      "rules": {
        "no-console": "off",
        "import/no-extraneous-dependencies": ["error", {"devDependencies": ["**/*.test.js", "**/*.test.ts", "**/*.spec.js", "**/*.spec.ts", "jest.config.js", "**/*wdyr*", "src/ui/**/*"]}],
        "import/extensions": ["error", "ignorePackages", {
          "js": "never",
          "jsx": "never",
          "ts": "never",
          "tsx": "never"
        }],
        "import/no-unresolved": ["error", { "ignore": ["^react$", "^ink$"] }],
        "no-plusplus": "off",
        "class-methods-use-this": "off",
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": "warn",
        "no-await-in-loop": "warn",
        "no-restricted-syntax": "off",
        "import/prefer-default-export": "off",
        "max-len": ["error", { "code": 200, "ignoreComments": true, "ignoreUrls": true }],
        "no-param-reassign": "off",
        "no-underscore-dangle": "off",
        "consistent-return": "off",
        "no-control-regex": "off",
        "no-else-return": "off",
        "no-shadow": "off",
        "no-nested-ternary": "off",
        "global-require": "off",
        "@typescript-eslint/no-require-imports": "off",
        "default-case": "off",
        "no-restricted-globals": "warn",
        "implicit-arrow-linebreak": "off",
        "function-paren-newline": "off",
        "comma-dangle": "off",
        "no-trailing-spaces": "off",
        "arrow-parens": "off",
        "no-useless-constructor": "off",
        "no-empty-function": "off",
        "no-promise-executor-return": "off",
        "no-useless-escape": "off",
        "no-continue": "off",
        "no-shadow": "off"
      }
    }
  ]
}