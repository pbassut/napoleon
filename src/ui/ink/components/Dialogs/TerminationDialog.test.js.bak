const React = require('react');
const { render } = require('ink-testing-library');

// Mock the TerminationDialog component since it's TypeScript
jest.mock('./TerminationDialog', () => {
  const React = require('react');
  const { Box, Text, useInput } = require('ink');
  
  const TerminationDialog = ({ isOpen, agent, onConfirm, onCancel }) => {
    const [selected, setSelected] = React.useState('no');
    const [loading, setLoading] = React.useState(false);
    
    useInput((input, key) => {
      if (loading) return;
      
      if (key.escape) {
        onCancel();
      } else if (input === 'y') {
        setLoading(true);
        onConfirm();
      } else if (input === 'n') {
        onCancel();
      } else if (key.tab || key.rightArrow || key.leftArrow) {
        setSelected(selected === 'no' ? 'yes' : 'no');
      } else if (key.return) {
        if (selected === 'yes') {
          setLoading(true);
          onConfirm();
        } else {
          onCancel();
        }
      }
    });
    
    if (!isOpen || !agent) return null;
    
    const formatRuntime = (startTime) => {
      if (!startTime) return 'Unknown';
      const runtime = Date.now() - startTime.getTime();
      const minutes = Math.floor(runtime / 60000);
      const hours = Math.floor(minutes / 60);
      const mins = minutes % 60;
      return hours > 0 ? `${hours}h ${mins}m` : `${minutes}m`;
    };
    
    return React.createElement(Box, {
      flexDirection: 'column',
      borderStyle: 'single',
      borderColor: 'red',
      padding: 1
    }, [
      React.createElement(Text, { key: 'title', bold: true, color: 'red' }, 'Terminate Agent?'),
      React.createElement(Text, { key: 'agent' }, `Agent: ${agent.name}`),
      React.createElement(Text, { key: 'status' }, `Status: ${agent.status}`),
      React.createElement(Text, { key: 'runtime' }, `Runtime: ${formatRuntime(agent.startTime)}`),
      React.createElement(Text, { key: 'warning', color: 'red' }, 'This will stop the agent'),
      loading ? 
        React.createElement(Text, { key: 'loading' }, 'Terminating...') :
        React.createElement(Box, { key: 'buttons' }, [
          React.createElement(Text, { key: 'no' }, selected === 'no' ? '[No]' : 'No'),
          React.createElement(Text, { key: 'yes' }, selected === 'yes' ? '[Yes]' : 'Yes'),
          React.createElement(Text, { key: 'hint' }, 'Press y/n or Enter to confirm')
        ])
    ]);
  };
  
  return { TerminationDialog };
});

const { TerminationDialog } = require('./TerminationDialog');

describe('TerminationDialog', () => {
  const mockAgent = {
    id: 'test-123',
    name: 'test-agent',
    status: 'running',
    startTime: new Date(Date.now() - 900000), // 15 minutes ago
  };

  const defaultProps = {
    isOpen: true,
    agent: mockAgent,
    onConfirm: jest.fn(),
    onCancel: jest.fn(),
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should not render when isOpen is false', () => {
    const { lastFrame } = render(
      React.createElement(TerminationDialog, { ...defaultProps, isOpen: false })
    );
    
    expect(lastFrame()).toBe('');
  });

  it('should not render when agent is null', () => {
    const { lastFrame } = render(
      React.createElement(TerminationDialog, { ...defaultProps, agent: null })
    );
    
    expect(lastFrame()).toBe('');
  });

  it('should render dialog with agent information', () => {
    const { lastFrame } = render(React.createElement(TerminationDialog, defaultProps));
    const output = lastFrame();
    
    expect(output).toContain('Terminate Agent?');
    expect(output).toContain('test-agent');
    expect(output).toContain('running');
    expect(output).toContain('15m'); // Runtime
    expect(output).toContain('This will stop the agent');
  });

  it('should call onCancel when Escape is pressed', async () => {
    const { stdin } = render(React.createElement(TerminationDialog, defaultProps));
    
    stdin.write('\x1B'); // Escape key
    
    expect(defaultProps.onCancel).toHaveBeenCalledTimes(1);
    expect(defaultProps.onConfirm).not.toHaveBeenCalled();
  });

  it('should call onCancel when n is pressed', async () => {
    const { stdin } = render(React.createElement(TerminationDialog, defaultProps));
    
    stdin.write('n');
    
    expect(defaultProps.onCancel).toHaveBeenCalledTimes(1);
    expect(defaultProps.onConfirm).not.toHaveBeenCalled();
  });

  it('should call onConfirm when y is pressed', async () => {
    const { stdin } = render(React.createElement(TerminationDialog, defaultProps));
    
    stdin.write('y');
    
    expect(defaultProps.onConfirm).toHaveBeenCalledTimes(1);
    expect(defaultProps.onCancel).not.toHaveBeenCalled();
  });

  it('should call onCancel when Enter is pressed with No selected', async () => {
    const { stdin } = render(React.createElement(TerminationDialog, defaultProps));
    
    // Default is No, so just press Enter
    stdin.write('\r'); // Return/Enter key
    
    expect(defaultProps.onCancel).toHaveBeenCalledTimes(1);
    expect(defaultProps.onConfirm).not.toHaveBeenCalled();
  });

  it('should show Unknown runtime when startTime is not provided', () => {
    const agentWithoutStartTime = {
      ...mockAgent,
      startTime: undefined,
    };
    
    const { lastFrame } = render(
      React.createElement(TerminationDialog, { ...defaultProps, agent: agentWithoutStartTime })
    );
    
    expect(lastFrame()).toContain('Unknown');
  });
});