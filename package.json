{
  "name": "napoleon-cli",
  "version": "1.0.10",
  "description": "Napoleon - Agent Driven Development Manager - CLI tool for managing multiple Claude Code SDK sessions",
  "main": "src/cli/index.js",
  "bin": {
    "napoleon-cli": "./bin/napoleon.js",
    "napoleon": "./bin/napoleon.js",
    "migrate-to-napoleon": "./bin/migrate-to-napoleon.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "bunfig.toml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "node test-ink-ui.js",
    "test:ui-framework": "ts-node --project src/ui-tests/tsconfig.json src/ui-tests/run-ui-tests.ts",
    "lint": "eslint src/ bin/ --ext .js,.ts,.tsx",
    "lint:fix": "eslint src/ bin/ --ext .js,.ts,.tsx --fix",
    "format": "prettier --write src/ bin/ __tests__/",
    "start": "bun bin/napoleon.js start",
    "dev": "bun bin/napoleon.js start",
    "migration:prepare": "node scripts/prepare-migration.js",
    "migration:test": "npm run test:ui",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "publish:prepare": "scripts/publish.sh",
    "publish:dry-run": "DRY_RUN=true scripts/publish.sh",
    "publish:patch": "scripts/publish-version.sh patch",
    "publish:minor": "scripts/publish-version.sh minor",
    "publish:major": "scripts/publish-version.sh major",
    "publish:prerelease": "scripts/publish-version.sh prerelease",
    "version:patch": "scripts/version.sh patch",
    "version:minor": "scripts/version.sh minor",
    "version:major": "scripts/version.sh major",
    "version:prerelease": "scripts/version.sh prerelease",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.53",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "diff": "^8.0.2",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "inquirer": "^12.7.0",
    "joi": "^17.11.0",
    "react": "^18.2.0",
    "semver": "^7.5.4",
    "strip-ansi": "^7.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.79",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@welldone-software/why-did-you-render": "^8.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "claude",
    "cli",
    "agent",
    "development",
    "terminal",
    "ai"
  ],
  "author": "Napoleon Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pbassut/napoleon.git"
  },
  "bugs": {
    "url": "https://github.com/pbassut/napoleon/issues"
  },
  "homepage": "https://github.com/pbassut/napoleon#readme",
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix"
  }
}
