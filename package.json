{
  "name": "@napoleon/cli",
  "version": "1.0.0",
  "description": "Napoleon - Agent Driven Development Manager - CLI tool for managing multiple Claude Code SDK sessions",
  "main": "src/cli/index.js",
  "bin": {
    "napoleon": "./bin/napoleon.js",
    "migrate-to-napoleon": "./bin/migrate-to-napoleon.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ bin/ --ext .js",
    "lint:fix": "eslint src/ bin/ --ext .js --fix",
    "format": "prettier --write src/ bin/ __tests__/",
    "start": "node bin/napoleon.js start"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.53",
    "blessed": "^0.1.81",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "inquirer": "^12.7.0",
    "joi": "^17.11.0",
    "semver": "^7.5.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
    "claude",
    "cli",
    "agent",
    "development",
    "terminal",
    "ai"
  ],
  "author": "Napoleon Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pbassut/napoleon.git"
  },
  "bugs": {
    "url": "https://github.com/pbassut/napoleon/issues"
  },
  "homepage": "https://github.com/pbassut/napoleon#readme"
}
